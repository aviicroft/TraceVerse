# Blockchain Intelligence API Configuration
# Supported providers: Etherscan, Blockscout, or compatible EVM API
BLOCKCHAIN_API_KEY=
BLOCKCHAIN_API_URL=https://api.etherscan.io/v2/api

# TronGrid API Configuration (Tron / TRC-20 USDT intelligence)
TRONGRID_API_KEY=

# Database Configuration (SQLite default for zero-setup local run, PostgreSQL supported)
DATABASE_URL=sqlite+aiosqlite:///./crypto_trace.db

# Graph & Traversal Bounds
MAX_HOPS=3
MAX_NODES_PER_ANALYSIS=150
MAX_TRANSACTIONS_PER_ADDRESS=50

# Request & Rate Limit Settings
REQUEST_TIMEOUT_SECONDS=15
MAX_RETRIES=3
RATE_LIMIT_DELAY_SECONDS=0.25
